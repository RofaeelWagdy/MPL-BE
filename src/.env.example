# ---------------------------------------------------------------
# Copy this file to .env and fill in the values before running.
# Never commit .env to version control.
# ---------------------------------------------------------------

# Application
APP_NAME="Morkosia PrepaLeague API"
APP_VERSION="1.0.0"
ENVIRONMENT=development          # development | production | test
DEBUG=false

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mpl

# Auth
# DEV_KEY grants instant SuperAdmin access via the x-dev-key header.
# Must be at least 32 characters long in production.
DEV_KEY=

# Secret key used to sign any future JWT tokens.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=

# Super admin seed user
SUPER_ADMIN_FULL_NAME=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
